# ── Admin auth ────────────────────────────────────────────────────────────────
# Password for the /admin/jobs dashboard.
# Change this before deploying to production.
ADMIN_PASSWORD=zinoit2024

# ── Vercel KV (optional — only needed in production) ──────────────────────────
# If these are set, job data is stored in Vercel KV (Redis).
# If not set, the app reads/writes data/jobs.json directly (good for dev).
#
# Get these values from your Vercel project dashboard:
#   Project → Storage → KV → .env.local
#
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ── Email / Resume submissions ────────────────────────────────────────────────
# Gmail: enable 2-Step Verification, create an App Password at:
# myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
RESUME_TO_EMAIL=info@zinoit-tech.com
